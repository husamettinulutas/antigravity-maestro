# Copy to `.env` and fill in a Google OAuth client approved for the Cloud Code
# scopes. `esbuild.js` bakes these into `dist/extension.js` at build time; `.env`
# itself is git-ignored and is never part of a commit or a .vsix.
#
# Leave them empty to build without a built-in client. Sign-in then requires the
# antigravityMaestro.oauth.clientId / clientSecret settings.
AGM_OAUTH_CLIENT_ID=
AGM_OAUTH_CLIENT_SECRET=
